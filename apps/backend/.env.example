# Server Configuration
PORT=4000
NODE_ENV=development

# Development Settings
DEV_BYPASS_PERMISSIONS=false

# Database Configuration
DB_URL=postgresql://user:password@localhost:5432/boilerplate

# JWT Configuration (Web App - Dietitians/Admins)
JWT_ACCESS_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# JWT Configuration (Mobile App - Clients)
JWT_CLIENT_ACCESS_SECRET=your-client-access-secret-change-in-production
JWT_CLIENT_ACCESS_EXPIRES_IN=24h
JWT_CLIENT_REFRESH_SECRET=your-client-refresh-secret-change-in-production
JWT_CLIENT_REFRESH_EXPIRES_IN=7d

# API Configuration (Optional)
API_SMOKE_TEST=0

# Typesense (Internal - for indexing)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=your-admin-api-key
TYPESENSE_ENABLED=false

# Typesense (Public - returned to frontend)
TYPESENSE_PUBLIC_HOST=localhost
TYPESENSE_PUBLIC_PORT=8108
TYPESENSE_PUBLIC_PROTOCOL=http
TYPESENSE_SEARCH_KEY=your-typesense-search-key

# Dodo Payments (Billing)
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_SECRET=your-webhook-secret
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Dodo Plan Product IDs (from Dodo Dashboard)
DODO_PRODUCT_BASIC=your-basic-product-id
DODO_PRODUCT_PRO=your-pro-product-id

# Dodo Checkout return URL
DODO_CHECKOUT_RETURN_URL=http://localhost:3000/dashboard/settings/billing

# Razorpay (INR Billing)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Razorpay Plan IDs (from Razorpay Dashboard)
RAZORPAY_PLAN_BASIC_MONTHLY=plan_xxx
RAZORPAY_PLAN_BASIC_YEARLY=plan_xxx
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxx
RAZORPAY_PLAN_PRO_YEARLY=plan_xxx

# Razorpay Checkout return URL
RAZORPAY_CHECKOUT_RETURN_URL=http://localhost:3000/dashboard/settings/billing

# Organization Integrations
# 64-char hex key (AES-256) used to encrypt per-org third-party credentials
# (e.g. an org's own Razorpay keys). Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Zoho Books OAuth app (register at api-console.zoho.com; add the
# /api/v1/integrations/callback redirect URI). ZOHO_ACCOUNTS_URL sets the
# data center to initiate auth against (accounts.zoho.com / .in / .eu).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Website URL (for recipe links in mobile app)
WEBSITE_BASE_URL=http://localhost:3001

# Meta Conversions API (server-side pixel events)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_CODE=

# SEO Article Pipeline
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6
WEBSITE_URL=http://localhost:3001
BLOG_REVALIDATE_SECRET=replace-with-random-secret
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Signup Waitlist Mode
# When 'true', POST /auth/register captures leads to email instead of
# creating orgs/users. Notification email goes to SIGNUP_WAITLIST_NOTIFY_EMAIL.
SIGNUP_WAITLIST_MODE=false
SIGNUP_WAITLIST_NOTIFY_EMAIL=hello@rabbithr.co

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rabbithr.co

# Error tracking + performance (GlitchTip / Sentry).
# Leave DSN blank to disable. Must be set on BOTH the api and worker containers.
# SENTRY_TRACES_SAMPLE_RATE: 0 = errors only (no timings). 0.1-0.2 recommended in
# prod to capture per-endpoint response times on the GlitchTip Performance tab.
GLITCHTIP_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_RELEASE=

# Google Search Console (article performance sync + sitemap ping on publish).
# The service-account key (credentials/gsc-reader-rabbithr.json) is committed and
# read directly — no env needed to enable GSC. The vars below are OPTIONAL overrides.
# Property to query (Domain property = sc-domain:<host>). Defaults to sc-domain:rabbithr.co.
GSC_SITE_URL=
# Override the committed key: base64/raw JSON (GSC_SERVICE_ACCOUNT_JSON) or a file path.
GSC_SERVICE_ACCOUNT_JSON=
GSC_CREDENTIALS_PATH=
# Optional override; defaults to `${WEBSITE_URL}/sitemap.xml`.
GSC_SITEMAP_URL=

# Automated article pipeline (brief planner + draft generator + auto-publish).
# Defaults run the pipeline hands-off: ~1 article auto-published every 2 days.
# Master kill switch — set to true to halt ALL article automation.
ARTICLE_AUTOMATION_DISABLED=
# Auto-publish generated articles. Set to false to generate drafts only (manual publish).
ARTICLE_AUTO_PUBLISH=
# Days between auto-published articles (cadence). Default 2.
ARTICLE_CADENCE_DAYS=
# How many ready briefs to keep queued. Default 5.
ARTICLE_BRIEF_QUEUE_TARGET=
# Max briefs the planner creates per run. Default 2.
ARTICLE_MAX_BRIEFS_PER_RUN=
# Min word count for an article to pass the auto-publish quality gate. Default 600.
ARTICLE_MIN_WORD_COUNT=

# Candidate portal tokens (separate from recruiter JWT secrets).
# Outside production, if unset, they are derived from JWT_ACCESS_SECRET / JWT_REFRESH_SECRET.
# Production requires explicit values.
CANDIDATE_PORTAL_JWT_ACCESS_SECRET=
CANDIDATE_PORTAL_JWT_ACCESS_EXPIRES_IN=1h
CANDIDATE_PORTAL_JWT_REFRESH_SECRET=
CANDIDATE_PORTAL_JWT_REFRESH_EXPIRES_IN=30d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# File storage for CVs and documents (S3 compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_SERVICE=S3
S3_BUCKET_NAME=rabbithr
S3_REGION=auto
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-storage-access-key
AWS_SECRET_ACCESS_KEY=your-storage-secret-key
CDN_URL=

# Email (RESEND or SES)
MAIL_PROVIDER=RESEND
RESEND_API_KEY=your-resend-api-key
MAIL_FROM_EMAIL=hello@yourdomain.com
MAIL_FROM_NAME=RabbitHR
