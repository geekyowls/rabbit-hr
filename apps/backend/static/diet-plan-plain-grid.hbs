<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Diet Plan - {{clientName}}</title>
    <style>
        @page { size: A4 landscape; margin: 12mm; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: Arial, Helvetica, 'Segoe UI', sans-serif;
            color: #000;
            font-size: 10px;
            line-height: 1.4;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            border-bottom: 2px solid #000;
            padding-bottom: 8px;
            margin-bottom: 6px;
        }
        .brand { display: flex; align-items: center; gap: 8px; }
        .logo { width: 32px; height: 32px; flex-shrink: 0; }
        .logo img { width: 100%; height: 100%; object-fit: contain; border-radius: 4px; }
        .logo-initials { width: 32px; height: 32px; background: #333; color: #fff; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; border-radius: 4px; }
        .clinic { font-size: 15px; font-weight: 700; }
        .clinic .by { font-size: 9px; font-weight: 400; color: #444; margin-top: 2px; }
        .title-block { text-align: right; }
        .client-name { font-size: 13px; font-weight: 700; }
        .date-range { font-size: 10px; color: #333; margin-top: 2px; }

        .targets {
            font-size: 9.5px;
            color: #333;
            padding: 5px 0 7px;
            margin-bottom: 8px;
            border-bottom: 1px solid #000;
        }
        .targets strong { color: #000; }

        table.grid {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        table.grid th, table.grid td {
            border: 1px solid #000;
            padding: 6px 7px;
            vertical-align: top;
            text-align: left;
        }
        table.grid thead th {
            background: #ececec;
            font-size: 10px;
            font-weight: 700;
            text-align: center;
        }
        table.grid thead th.corner { text-align: left; }
        table.grid thead th .day-date {
            display: block;
            font-weight: 400;
            font-size: 8.5px;
            color: #333;
            margin-top: 1px;
        }
        table.grid tbody th.meal-cell {
            width: 96px;
            background: #f6f6f6;
            font-weight: 700;
            font-size: 10px;
            text-align: left;
        }
        table.grid tbody th .meal-time {
            display: block;
            font-weight: 400;
            font-size: 8.5px;
            color: #444;
            margin-top: 2px;
        }

        .item { padding: 1.5px 0; }
        .food { font-weight: 600; color: #000; text-decoration: none; }
        a.food { text-decoration: underline; }
        .qty { color: #444; }
        .item-cal { color: #444; font-size: 8.5px; }
        .empty { color: #999; }

        .section { margin-top: 12px; page-break-inside: avoid; }
        .section h3 {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid #000;
            padding-bottom: 3px;
            margin-bottom: 5px;
        }
        .section .sub { font-weight: 700; font-size: 9.5px; margin-top: 5px; }
        .section ul { padding-left: 16px; font-size: 9.5px; }
        .section li { margin-bottom: 2px; }

        .footer {
            margin-top: 14px;
            padding-top: 6px;
            border-top: 1px solid #000;
            display: flex;
            justify-content: space-between;
            font-size: 8.5px;
            color: #444;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="brand">
            <div class="logo">
                {{#if clinicLogo}}
                <img src="{{clinicLogo}}" alt="Logo">
                {{else}}
                <div class="logo-initials">{{clinicInitials}}</div>
                {{/if}}
            </div>
            <div class="clinic">
                {{clinicName}}
                <div class="by">Prepared by {{dietitianName}}</div>
            </div>
        </div>
        <div class="title-block">
            <div class="client-name">{{clientName}}</div>
            <div class="date-range">{{dateRange}}</div>
        </div>
    </div>

    {{#if targetCalories}}
    <div class="targets">
        <strong>Daily target:</strong> {{targetCalories}} kcal{{#if targetProtein}} · Protein {{targetProtein}}g{{/if}}{{#if targetCarbs}} · Carbs {{targetCarbs}}g{{/if}}{{#if targetFat}} · Fat {{targetFat}}g{{/if}}
    </div>
    {{/if}}

    {{#if weeklyGrid}}
    <table class="grid">
        <thead>
            <tr>
                <th class="corner">Meal</th>
                {{#each weeklyGrid.days}}
                <th>Day {{dayNumber}}<span class="day-date">{{dateFormatted}}</span></th>
                {{/each}}
            </tr>
        </thead>
        <tbody>
            {{#each weeklyGrid.rows}}
            <tr>
                <th class="meal-cell">{{mealName}}{{#if time}}<span class="meal-time">{{time}}</span>{{/if}}</th>
                {{#each cells}}
                <td>
                    {{#if items.length}}
                    {{#each items}}
                    <div class="item">
                        {{#if recipeUrl}}<a class="food" href="{{recipeUrl}}" target="_blank">{{foodName}}</a>{{else}}<span class="food">{{foodName}}</span>{{/if}}{{#if @root.includeQuantity}}<span class="qty"> ({{quantity}} {{unit}})</span>{{/if}}{{#if nutrition.calories}} <span class="item-cal">{{nutrition.calories}} cal</span>{{/if}}
                    </div>
                    {{/each}}
                    {{else}}
                    <span class="empty">-</span>
                    {{/if}}
                </td>
                {{/each}}
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{/if}}

    {{#if guidelines.hasAny}}
    <div class="section">
        <h3>Guidelines</h3>
        {{#if guidelines.dos.length}}<div class="sub">Do</div><ul>{{#each guidelines.dos}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
        {{#if guidelines.donts.length}}<div class="sub">Don't</div><ul>{{#each guidelines.donts}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
        {{#if guidelines.instructions.length}}<div class="sub">Instructions</div><ul>{{#each guidelines.instructions}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </div>
    {{/if}}

    {{#if notes.length}}
    <div class="section">
        <h3>Notes</h3>
        <ul>{{#each notes}}<li>{{this}}</li>{{/each}}</ul>
    </div>
    {{/if}}

    <div class="footer">
        <span>{{clinicName}}</span>
        {{#if contactInfo}}<span>{{contactInfo}}</span>{{/if}}
    </div>
</body>
</html>
