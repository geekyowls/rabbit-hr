<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Diet Plan - {{clientName}}</title>
    <style>
        :root {
            --green: #2f6b4f;
            --green-soft: #eef4f0;
            --ink: #1a1a1a;
            --muted: #5a6570;
            --line: #d8ddd9;
        }
        @page { size: A4; margin: 0; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Arial, Helvetica, 'Segoe UI', sans-serif;
            color: var(--ink);
            font-size: 12px;
            line-height: 1.5;
        }
        .container { padding: 12mm; }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            border-bottom: 2px solid var(--green);
            padding-bottom: 8px;
            margin-bottom: 4px;
        }
        .brand { display: flex; align-items: center; gap: 8px; }
        .logo { width: 32px; height: 32px; flex-shrink: 0; }
        .logo img { width: 100%; height: 100%; object-fit: contain; border-radius: 6px; }
        .logo-initials { width: 32px; height: 32px; background: var(--green); color: #fff; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; border-radius: 6px; }
        .clinic { font-size: 16px; font-weight: 700; color: var(--green); }
        .by { font-size: 10px; color: var(--muted); margin-top: 2px; }
        .title-block { text-align: right; }
        .client-name { font-size: 13px; font-weight: 700; }
        .date-range { font-size: 10px; color: var(--muted); margin-top: 2px; }

        .targets {
            font-size: 10px;
            color: var(--muted);
            padding: 6px 0;
            border-bottom: 1px solid var(--line);
            margin-bottom: 12px;
        }
        .targets strong { color: var(--ink); }

        .day { margin-bottom: 10px; page-break-inside: avoid; }
        .day-title {
            font-size: 12px;
            font-weight: 700;
            background: var(--green-soft);
            padding: 4px 8px;
            border-left: 3px solid var(--green);
            margin-bottom: 4px;
            display: flex;
            justify-content: space-between;
        }
        .day-title .cal { font-weight: 600; color: var(--green); }

        .line { display: flex; gap: 8px; padding: 2.5px 8px; }
        .line .t { flex: none; width: 68px; color: var(--muted); font-variant-numeric: tabular-nums; }
        .line .m { flex: none; width: 76px; font-weight: 700; }
        .line .f { flex: 1; }
        .line .f a { color: var(--green); text-decoration: none; }
        .qty { color: var(--muted); }

        .section { margin-top: 14px; page-break-inside: avoid; }
        .section h3 {
            font-size: 12px;
            font-weight: 700;
            color: var(--green);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--green);
            padding-bottom: 3px;
            margin-bottom: 6px;
        }
        .section .sub { font-weight: 700; font-size: 10.5px; margin-top: 5px; }
        .section ul { padding-left: 16px; font-size: 10.5px; color: var(--muted); }
        .section li { margin-bottom: 2px; }

        .footer {
            margin-top: 14px;
            padding-top: 6px;
            border-top: 1px solid var(--line);
            display: flex;
            justify-content: space-between;
            font-size: 9px;
            color: var(--muted);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="brand">
                <div class="logo">
                    {{#if clinicLogo}}
                    <img src="{{clinicLogo}}" alt="Logo">
                    {{else}}
                    <div class="logo-initials">{{clinicInitials}}</div>
                    {{/if}}
                </div>
                <div>
                    <div class="clinic">{{clinicName}}</div>
                    <div class="by">Prepared by {{dietitianName}}</div>
                </div>
            </div>
            <div class="title-block">
                <div class="client-name">{{clientName}}</div>
                <div class="date-range">{{dateRange}}</div>
            </div>
        </div>

        {{#if targetCalories}}
        <div class="targets">
            <strong>Daily target:</strong> {{targetCalories}} kcal{{#if targetProtein}} · Protein {{targetProtein}}g{{/if}}{{#if targetCarbs}} · Carbs {{targetCarbs}}g{{/if}}{{#if targetFat}} · Fat {{targetFat}}g{{/if}}
        </div>
        {{/if}}

        {{#each days}}
        <div class="day">
            <div class="day-title">
                <span>Day {{dayNumber}} · {{dateFormatted}}</span>
                {{#if totals.calories}}<span class="cal">{{totals.calories}} kcal</span>{{/if}}
            </div>
            {{#each meals}}
            {{#if items.length}}
            <div class="line">
                <span class="t">{{time}}</span>
                <span class="m">{{name}}</span>
                <span class="f">{{#each items}}{{#if recipeUrl}}<a href="{{recipeUrl}}" target="_blank">{{foodName}}</a>{{else}}{{foodName}}{{/if}}{{#if @root.includeQuantity}} <span class="qty">({{quantity}} {{unit}})</span>{{/if}}{{#unless @last}}, {{/unless}}{{/each}}</span>
            </div>
            {{/if}}
            {{/each}}
        </div>
        {{/each}}

        {{#if guidelines.hasAny}}
        <div class="section">
            <h3>Guidelines</h3>
            {{#if guidelines.dos.length}}<div class="sub">Do</div><ul>{{#each guidelines.dos}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
            {{#if guidelines.donts.length}}<div class="sub">Don't</div><ul>{{#each guidelines.donts}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
            {{#if guidelines.instructions.length}}<div class="sub">Instructions</div><ul>{{#each guidelines.instructions}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
        </div>
        {{/if}}

        {{#if notes.length}}
        <div class="section">
            <h3>Notes</h3>
            <ul>{{#each notes}}<li>{{this}}</li>{{/each}}</ul>
        </div>
        {{/if}}

        <div class="footer">
            <span>{{clinicName}}</span>
            {{#if contactInfo}}<span>{{contactInfo}}</span>{{/if}}
        </div>
    </div>
</body>
</html>
