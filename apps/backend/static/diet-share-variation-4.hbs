<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Diet Plan - {{clientName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Instrument+Serif&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0d9488;
            --primary-dark: #0f766e;
            --accent: #fbbf24;

            --bg: #f0fdf4;
            --surface: #ffffff;
            --border: #d1fae5;

            --text: #134e4a;
            --text-light: #5eead4;
            --text-muted: #14b8a6;

            --breakfast: #fb923c;
            --lunch: #34d399;
            --dinner: #a78bfa;
            --snack: #f472b6;

            --page-max-width: 900px;
        }

        @media print {
            body { display: none !important; }
            html::after {
                content: "Printing is disabled for this document.";
                display: block;
                padding: 50px;
                text-align: center;
                font-size: 18px;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        body {
            font-family: 'Sora', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            font-size: 14px;
        }

        img {
            pointer-events: none;
            -webkit-user-drag: none;
        }

        .container {
            max-width: var(--page-max-width);
            margin: 0 auto;
            padding: 20px;
            position: relative;
        }

        .watermark {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 80px;
            color: rgba(13, 148, 136, 0.04);
            pointer-events: none;
            white-space: nowrap;
            z-index: 1000;
            font-weight: bold;
            font-family: 'Instrument Serif', serif;
        }

        .header {
            text-align: center;
            padding: 2rem 0 2.5rem;
            border-bottom: 1px solid var(--border);
            margin-bottom: 2rem;
        }

        .logo {
            width: 56px;
            height: 56px;
            background: var(--primary);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Instrument Serif', serif;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 50%;
        }

        .clinic-name {
            font-family: 'Instrument Serif', serif;
            font-size: 1.75rem;
            color: var(--primary-dark);
            margin-bottom: 0.25rem;
        }

        .header-meta {
            font-size: 0.85rem;
            color: var(--primary);
            opacity: 0.8;
        }

        .client-info {
            background: var(--primary);
            color: white;
            text-align: center;
            padding: 2rem;
            border-radius: 24px;
            margin-bottom: 2.5rem;
            position: relative;
            overflow: hidden;
        }

        .client-info::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -20%;
            width: 200px;
            height: 200px;
            background: var(--accent);
            border-radius: 50%;
            opacity: 0.1;
        }

        .client-info::after {
            content: '';
            position: absolute;
            bottom: -30%;
            right: -10%;
            width: 150px;
            height: 150px;
            background: var(--accent);
            border-radius: 50%;
            opacity: 0.1;
        }

        .client-name {
            font-family: 'Instrument Serif', serif;
            font-size: 1.75rem;
            margin-bottom: 1rem;
            position: relative;
        }

        .client-details {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            font-size: 0.9rem;
            position: relative;
        }

        .client-details span {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            background: rgba(255,255,255,0.15);
            padding: 0.5rem 1rem;
            border-radius: 20px;
        }

        .days-container {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .day-card {
            background: var(--surface);
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        .day-header {
            background: var(--primary);
            padding: 1.25rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .day-title {
            font-family: 'Instrument Serif', serif;
            font-size: 1.5rem;
            color: white;
        }

        .day-date {
            font-size: 0.95rem;
            color: var(--text-light);
            font-weight: 500;
        }

        .meals-list {
            padding: 1.25rem;
        }

        .meal-item {
            display: grid;
            grid-template-columns: 100px 1fr;
            gap: 1rem;
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 0.75rem;
            background: var(--bg);
            align-items: start;
        }

        .meal-item:last-child { margin-bottom: 0; }

        .meal-type {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }

        .meal-type-badge {
            padding: 0.35rem 0.7rem;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            text-align: center;
            color: white;
        }

        .meal-type-badge.breakfast { background: var(--breakfast); }
        .meal-type-badge.lunch { background: var(--lunch); }
        .meal-type-badge.dinner { background: var(--dinner); }
        .meal-type-badge.snack { background: var(--snack); }
        .meal-type-badge.other { background: var(--text-muted); }

        .meal-time {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-align: center;
        }

        .food-items {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .food-item {
            display: flex;
            flex-direction: column;
            padding: 0.5rem 0;
            border-bottom: 1px dashed var(--border);
            gap: 0.2rem;
        }

        .food-item:last-child { border-bottom: none; }

        .food-item-main {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .food-notes {
            font-style: italic;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .food-name {
            font-size: 1rem;
            color: var(--text);
        }

        .food-link {
            color: var(--primary);
            text-decoration: none;
            border-bottom: 1px dashed var(--primary);
        }

        .food-link:hover {
            color: var(--primary-dark);
        }

        .food-qty {
            font-size: 0.9rem;
            color: var(--text-muted);
            white-space: nowrap;
            margin-left: auto;
            background: var(--surface);
            padding: 0.2rem 0.5rem;
            border-radius: 6px;
        }

        .food-alternatives {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 2px;
            padding-left: 8px;
        }

        .alternatives-label {
            font-style: italic;
            margin-right: 4px;
        }

        .alternative-item {
            margin-right: 4px;
        }

        .alt-link {
            color: var(--primary);
            text-decoration: none;
        }

        .alt-link:hover {
            color: var(--primary-dark);
        }

        .nutrition-values {
            display: inline-flex;
            gap: 0.4rem;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .nutrition-values .cal { color: #ea580c; }
        .nutrition-values .protein { color: #2563eb; }
        .nutrition-values .carbs { color: #16a34a; }
        .nutrition-values .fat { color: #d97706; }
        .meal-totals-bar {
            background: #fff7ed;
            padding: 0.4rem 0.75rem;
            border-radius: 6px;
            margin-bottom: 0.5rem;
        }
        .item-nutrition {
            font-size: 0.65rem;
            margin-top: 0.15rem;
            opacity: 0.85;
        }
        .day-nutrition {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        .guidelines-section {
            margin-top: 2rem;
        }

        .guidelines-section h3 {
            font-family: 'Instrument Serif', serif;
            font-size: 1.1rem;
            color: var(--primary-dark);
            margin-bottom: 0.75rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--primary-dark);
        }

        .guidelines-columns {
            display: flex;
            gap: 1rem;
        }

        @media (max-width: 600px) {
            .guidelines-columns {
                flex-direction: column;
            }
        }

        .guideline-block {
            flex: 1;
            background: var(--surface);
            border-radius: 16px;
            padding: 1rem;
            border: 1px solid var(--border);
        }

        .guideline-block h4 {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            padding-bottom: 0.4rem;
            border-bottom: 1px solid var(--border);
        }

        .guideline-block.dos h4 { color: #16a34a; }
        .guideline-block.donts h4 { color: #dc2626; }
        .guideline-block.instructions h4 { color: #2563eb; }

        .guideline-list {
            list-style: none;
            font-size: 0.85rem;
            color: var(--text);
            margin: 0;
            padding: 0;
        }

        .guideline-list li {
            padding: 0.25rem 0;
            padding-left: 1.25rem;
            position: relative;
        }

        .guideline-block.dos .guideline-list li::before {
            content: '\2713';
            position: absolute;
            left: 0;
            color: #16a34a;
            font-weight: bold;
        }

        .guideline-block.donts .guideline-list li::before {
            content: '\2717';
            position: absolute;
            left: 0;
            color: #dc2626;
            font-weight: bold;
        }

        .guideline-block.instructions .guideline-list li::before {
            content: '\2022';
            position: absolute;
            left: 0;
            color: #2563eb;
        }

        .notes-section {
            background: var(--surface);
            border-radius: 20px;
            padding: 1.5rem;
            margin-top: 2rem;
            border: 1px solid var(--border);
            position: relative;
        }

        .notes-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--accent);
            border-radius: 4px 0 0 4px;
        }

        .notes-section h3 {
            font-family: 'Instrument Serif', serif;
            font-size: 1.1rem;
            color: var(--primary-dark);
            margin-bottom: 0.75rem;
        }

        .notes-list {
            list-style: none;
            font-size: 0.9rem;
            color: var(--text);
        }

        .notes-list li {
            padding: 0.4rem 0;
            padding-left: 1.5rem;
            position: relative;
        }

        .notes-list li::before {
            content: '\25CF';
            position: absolute;
            left: 0;
            color: var(--primary);
            font-size: 0.6rem;
            top: 0.6rem;
        }

        .footer {
            text-align: center;
            margin-top: 2rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border);
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .empty-meal {
            color: var(--text-muted);
            font-style: italic;
            font-size: 0.9rem;
        }

        @media (max-width: 600px) {
            .container { padding: 12px; }
            .day-header {
                flex-wrap: wrap;
                gap: 0.25rem 0.75rem;
            }
            .day-title {
                font-size: 1.2rem;
            }
            .day-date {
                font-size: 0.85rem;
            }
            .day-nutrition {
                width: 100%;
                margin-top: 0.25rem;
            }
            .meal-item {
                grid-template-columns: 1fr;
                gap: 0.6rem;
            }
            .meal-type {
                flex-direction: row;
                align-items: center;
                gap: 0.6rem;
            }
            .client-info {
                padding: 1.5rem;
            }
            .client-details {
                flex-wrap: wrap;
                gap: 0.75rem;
            }
            .header {
                padding: 1.5rem 0 2rem;
            }
            .watermark {
                font-size: 40px;
            }
        }
    </style>
</head>
<body>
    <div class="watermark">{{clinicName}}</div>

    <div class="container">
        <header class="header">
            <div class="logo">
                {{#if clinicLogo}}
                <img src="{{clinicLogo}}" alt="Logo">
                {{else}}
                {{clinicInitials}}
                {{/if}}
            </div>
            <div class="clinic-name">{{clinicName}}</div>
            <div class="header-meta">Personalized Diet Plan</div>
        </header>

        <section class="client-info">
            <div class="client-name">{{clientName}}</div>
            <div class="client-details">
                <span>{{dateRange}}</span>
                {{#if targetCalories}}<span>{{targetCalories}} kcal/day</span>{{/if}}
                {{#if targetProtein}}<span>P:{{targetProtein}}g</span>{{/if}}
                {{#if targetCarbs}}<span>C:{{targetCarbs}}g</span>{{/if}}
                {{#if targetFat}}<span>F:{{targetFat}}g</span>{{/if}}
            </div>
        </section>

        <nav class="day-nav" aria-label="Jump to day">
            <div class="day-nav-scroll" id="dayNavScroll">
                {{#each days}}
                <a class="day-chip" data-date="{{date}}" data-day-id="day-{{dayNumber}}" href="#day-{{dayNumber}}">
                    <span class="chip-label">Day {{dayNumber}}</span>
                    <span class="chip-date">{{dateFormatted}}</span>
                </a>
                {{/each}}
            </div>
        </nav>

        <div class="days-container">
            {{#each days}}
            <article class="day-card" id="day-{{dayNumber}}" data-date="{{date}}">
                <div class="day-header">
                    <div class="day-title">Day {{dayNumber}}</div>
                    <div class="day-date">{{dateFormatted}}</div>
                    {{#if totals.calories}}
                    <div class="day-nutrition">
                        <span class="nutrition-values">
                            <span class="cal">{{totals.calories}} cal</span>
                            <span class="protein">P:{{totals.protein}}</span>
                            <span class="carbs">C:{{totals.carbs}}</span>
                            <span class="fat">F:{{totals.fat}}</span>
                        </span>
                    </div>
                    {{/if}}
                </div>
                <div class="meals-list">
                    {{#each meals}}
                    <div class="meal-item">
                        <div class="meal-type">
                            <div class="meal-type-badge {{mealTypeClass}}">{{name}}</div>
                            {{#if time}}
                            <div class="meal-time">{{time}}</div>
                            {{/if}}
                        </div>
                        <div class="food-items">
                            {{#if totals.calories}}
                            <div class="meal-totals-bar">
                                <span class="nutrition-values">
                                    <span class="cal">{{totals.calories}} cal</span>
                                    <span class="protein">P:{{totals.protein}}</span>
                                    <span class="carbs">C:{{totals.carbs}}</span>
                                    <span class="fat">F:{{totals.fat}}</span>
                                </span>
                            </div>
                            {{/if}}
                            {{#if items.length}}
                            {{#each items}}
                            <div class="food-item">
                                <div class="food-item-main">
                                    {{#if recipeUrl}}
                                    <a href="{{recipeUrl}}" class="food-name food-link" target="_blank" rel="noopener">{{foodName}}</a>
                                    {{else}}
                                    <span class="food-name">{{foodName}}</span>
                                    {{/if}}
                                    {{#if @root.includeQuantity}}<span class="food-qty">{{quantity}} {{unit}}</span>{{/if}}
                                </div>
                                {{#if nutrition.calories}}
                                <div class="item-nutrition">
                                    <span class="nutrition-values">
                                        <span class="cal">{{nutrition.calories}} cal</span>
                                        <span class="protein">P:{{nutrition.protein}}</span>
                                        <span class="carbs">C:{{nutrition.carbs}}</span>
                                        <span class="fat">F:{{nutrition.fat}}</span>
                                    </span>
                                </div>
                                {{/if}}
                                {{#if notes}}
                                <div class="food-notes">{{notes}}</div>
                                {{/if}}
                                {{#if alternatives.length}}
                                <div class="food-alternatives">
                                    <span class="alternatives-label">Or:</span>
                                    {{#each alternatives}}
                                    <span class="alternative-item">
                                        {{#if recipeUrl}}
                                        <a href="{{recipeUrl}}" class="alt-link" target="_blank" rel="noopener">{{foodName}}</a>
                                        {{else}}
                                        {{foodName}}
                                        {{/if}}
                                        {{#if @root.includeQuantity}}({{quantity}} {{unit}}){{/if}}{{#if notes}} - {{notes}}{{/if}}{{#unless @last}},{{/unless}}
                                    </span>
                                    {{/each}}
                                </div>
                                {{/if}}
                            </div>
                            {{/each}}
                            {{else}}
                            <div class="empty-meal">No items</div>
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </article>
            {{/each}}
        </div>

        {{#if guidelines.hasAny}}
        <section class="guidelines-section">
            <h3>Guidelines</h3>
            <div class="guidelines-columns">
                {{#if guidelines.dos.length}}
                <div class="guideline-block dos">
                    <h4>Do's</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.dos}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
                {{#if guidelines.donts.length}}
                <div class="guideline-block donts">
                    <h4>Don'ts</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.donts}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
                {{#if guidelines.instructions.length}}
                <div class="guideline-block instructions">
                    <h4>Instructions</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.instructions}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
            </div>
        </section>
        {{/if}}

        {{#if notes.length}}
        <section class="notes-section">
            <h3>Notes</h3>
            <ul class="notes-list">
                {{#each notes}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </section>
        {{/if}}

        {{#if contactInfo}}
        <footer class="footer">
            <p>Generated by {{clinicName}} • {{contactInfo}}</p>
        </footer>
        {{/if}}
    </div>

    <script>
        (function() {
            document.addEventListener('contextmenu', function(e) {
                e.preventDefault();
                return false;
            });

            document.addEventListener('keydown', function(e) {
                if (e.ctrlKey || e.metaKey) {
                    if (e.key === 'p' || e.key === 'P' ||
                        e.key === 's' || e.key === 'S' ||
                        e.key === 'c' || e.key === 'C' ||
                        e.key === 'a' || e.key === 'A') {
                        e.preventDefault();
                        return false;
                    }
                }
                if (e.key === 'PrintScreen') {
                    e.preventDefault();
                    return false;
                }
            });

            document.addEventListener('copy', function(e) {
                e.preventDefault();
                return false;
            });

            document.addEventListener('cut', function(e) {
                e.preventDefault();
                return false;
            });

            if (window.matchMedia) {
                var mediaQueryList = window.matchMedia('print');
                mediaQueryList.addListener(function(mql) {
                    if (mql.matches) {
                        document.body.style.display = 'none';
                    }
                });
            }
        })();
    </script>
<style>
.day-nav { background: #fff; border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; position: sticky; top: 8px; z-index: 10; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
.day-nav-scroll { display: flex; gap: 6px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
.day-nav-scroll::-webkit-scrollbar { height: 4px; }
.day-nav-scroll::-webkit-scrollbar-thumb { background: #cdd9cc; border-radius: 2px; }
.day-chip { flex-shrink: 0; background: #f1f5ed; border: 1.5px solid transparent; color: #1a2a1e; border-radius: 8px; padding: 8px 12px; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.15s; min-width: 90px; text-align: center; }
.day-chip:hover { background: #e3ead9; }
.day-chip.active { background: #1d3d28; color: #fff; border-color: #1d3d28; }
.day-chip.is-today { border-color: #1d3d28; }
.day-chip .chip-label { display: block; font-size: 12px; }
.day-chip .chip-date { display: block; font-size: 11px; opacity: 0.8; font-weight: 500; margin-top: 1px; }
.day-chip.is-today .chip-label::before { content: '\2605 '; }
.day-card { scroll-margin-top: 90px; }
</style>
<script>
(function(){
  var todayLocal = (function(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); })();
  var chips = document.querySelectorAll('.day-chip');
  var sections = document.querySelectorAll('.day-card');
  var scroller = document.getElementById('dayNavScroll');
  function setActive(id){ chips.forEach(function(c){ c.classList.toggle('active', c.dataset.dayId === id); }); }
  var todayChip = null;
  chips.forEach(function(c){ if (c.dataset.date === todayLocal) { c.classList.add('is-today'); todayChip = c; } });
  if (todayChip && scroller) {
    var t = document.getElementById(todayChip.dataset.dayId);
    if (t) setTimeout(function(){ t.scrollIntoView({ behavior:'auto', block:'start' }); window.scrollBy(0, -8); }, 50);
    var r = todayChip.getBoundingClientRect();
    var sr = scroller.getBoundingClientRect();
    scroller.scrollLeft = todayChip.offsetLeft - (sr.width - r.width)/2;
    setActive(todayChip.dataset.dayId);
  } else if (chips.length) {
    setActive(chips[0].dataset.dayId);
  }
  if ('IntersectionObserver' in window && sections.length) {
    var obs = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if (e.isIntersecting) setActive(e.target.id); }); }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });
    sections.forEach(function(s){ obs.observe(s); });
  }
})();
</script>
</body>
</html>
