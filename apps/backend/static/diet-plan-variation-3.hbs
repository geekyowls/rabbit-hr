<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diet Plan - {{clientName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Fraunces:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --accent: #f59e0b;

            --bg: #fafafa;
            --surface: #ffffff;
            --border: #e5e7eb;

            --text: #111827;
            --text-secondary: #6b7280;
            --text-muted: #9ca3af;

            --breakfast: #f97316;
            --lunch: #22c55e;
            --dinner: #8b5cf6;
            --snack: #ec4899;

            --radius: 20px;
            --radius-sm: 12px;
        }

        @media print {
            @page { size: A4; margin: 0; }
            body { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
            .page-break { page-break-before: always; padding-top:8mm;}
            .meal-block { break-inside: avoid; page-break-inside: avoid; }
            .food-row { break-inside: avoid; page-break-inside: avoid; }
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Outfit', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            font-size: 16px;
        }

        .container {
            max-width: 860px;
            margin: 0 auto;
            padding: 8mm;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: 14px;
            display: grid;
            place-items: center;
            color: white;
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 1.25rem;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

        .logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 14px;
        }

        .clinic-name {
            font-family: 'Fraunces', serif;
            font-size: 1.35rem;
            font-weight: 600;
            color: var(--text);
        }

        .prepared-by {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .prepared-by strong {
            color: var(--text-secondary);
        }

        .client-card {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: var(--radius);
            padding: 1.75rem 2rem;
            margin-bottom: 2.5rem;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
            box-shadow: 0 8px 32px rgba(99, 102, 241, 0.25);
        }

        .client-name {
            font-family: 'Fraunces', serif;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .client-meta {
            display: flex;
            gap: 0.75rem;
        }

        .meta-tag {
            background: rgba(255,255,255,0.2);
            padding: 0.5rem 1rem;
            border-radius: 100px;
            font-size: 0.85rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .day-section {
            margin-bottom: 2rem;
        }

        .day-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--border);
        }

        .day-number {
            width: 56px;
            height: 56px;
            background: var(--text);
            color: white;
            border-radius: var(--radius-sm);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            line-height: 1.1;
        }

        .day-number span {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            opacity: 0.7;
        }

        .day-number strong {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .day-info h2 {
            font-family: 'Fraunces', serif;
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--text);
        }

        .day-info p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .meals-timeline {
            position: relative;
            padding-left: 2rem;
        }

        .meals-timeline::before {
            content: '';
            position: absolute;
            left: 7px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--border);
        }

        .meal-block {
            position: relative;
            background: var(--surface);
            border-radius: var(--radius-sm);
            padding: 1.25rem;
            margin-bottom: 1rem;
            border: 1px solid var(--border);
            transition: all 0.2s ease;
        }

        .meal-block:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        }

        .meal-block:last-child { margin-bottom: 0; }

        .meal-block::before {
            content: '';
            position: absolute;
            left: -2rem;
            top: 1.5rem;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 3px solid var(--surface);
            box-shadow: 0 0 0 2px var(--border);
        }

        .meal-block.breakfast::before { background: var(--breakfast); box-shadow: 0 0 0 2px var(--breakfast); }
        .meal-block.lunch::before { background: var(--lunch); box-shadow: 0 0 0 2px var(--lunch); }
        .meal-block.dinner::before { background: var(--dinner); box-shadow: 0 0 0 2px var(--dinner); }
        .meal-block.snack::before { background: var(--snack); box-shadow: 0 0 0 2px var(--snack); }
        .meal-block.other::before { background: var(--text-muted); box-shadow: 0 0 0 2px var(--text-muted); }

        .meal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .meal-type {
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .meal-block.breakfast .meal-type { color: var(--breakfast); }
        .meal-block.lunch .meal-type { color: var(--lunch); }
        .meal-block.dinner .meal-type { color: var(--dinner); }
        .meal-block.snack .meal-type { color: var(--snack); }
        .meal-block.other .meal-type { color: var(--text-muted); }

        .meal-time {
            font-size: 0.8rem;
            color: var(--text-muted);
            background: var(--bg);
            padding: 0.3rem 0.7rem;
            border-radius: 6px;
        }

        .food-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .food-row {
            display: flex;
            flex-direction: column;
            padding: 0.6rem 0;
            border-bottom: 1px dashed var(--border);
            gap: 0.15rem;
        }

        .food-row:last-child { border-bottom: none; }

        .food-row-main {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .food-notes {
            font-style: italic;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .food-name {
            font-size: 1rem;
            color: var(--text);
        }

        .food-link {
            color: var(--primary);
            text-decoration: none;
            border-bottom: 1px dashed var(--primary);
        }

        .food-link:hover {
            opacity: 0.8;
        }

        .food-qty {
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 500;
            flex-shrink: 0;
        }

        .empty-meal {
            color: var(--text-muted);
            font-style: italic;
            font-size: 0.85rem;
        }

        .food-alternatives {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 2px;
            padding-left: 8px;
        }

        .alternatives-label {
            font-style: italic;
            margin-right: 4px;
        }

        .alternative-item {
            margin-right: 4px;
        }

        .alt-link {
            color: var(--primary);
            text-decoration: none;
        }

        .alt-link:hover {
            opacity: 0.8;
        }

        .nutrition-values {
            display: inline-flex;
            gap: 0.4rem;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .nutrition-values .cal { color: #ea580c; }
        .nutrition-values .protein { color: #2563eb; }
        .nutrition-values .carbs { color: #16a34a; }
        .nutrition-values .fat { color: #d97706; }
        .meal-totals-bar {
            background: #fff7ed;
            padding: 0.4rem 0.75rem;
            border-radius: 6px;
            margin-bottom: 0.5rem;
        }
        .item-nutrition {
            font-size: 0.7rem;
            margin-top: 0.15rem;
            opacity: 0.85;
        }
        .day-nutrition {
            margin-top: 0.5rem;
        }

        .notes-card {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border-radius: var(--radius-sm);
            padding: 1.25rem 1.5rem;
            margin-top: 2rem;
        }

        .notes-card h3 {
            font-family: 'Fraunces', serif;
            font-size: 1rem;
            font-weight: 600;
            color: #92400e;
            margin-bottom: 0.75rem;
        }

        .notes-card ul {
            list-style: none;
            font-size: 0.9rem;
            color: #78350f;
        }

        .notes-card li {
            padding: 0.35rem 0;
            padding-left: 1.25rem;
            position: relative;
        }

        .notes-card li::before {
            content: '\2726';
            position: absolute;
            left: 0;
            color: #d97706;
        }

        .guidelines-section {
            margin-top: 1.5rem;
            page-break-inside: avoid;
        }

        .guidelines-section h3 {
            font-family: 'Fraunces', serif;
            font-size: 1.1rem;
            color: var(--primary);
            margin-bottom: 0.75rem;
            padding-bottom: 0.35rem;
            border-bottom: 2px solid var(--primary);
        }

        .guidelines-columns {
            display: flex;
            gap: 1rem;
        }

        .guideline-block {
            flex: 1;
            background: var(--surface);
            border-radius: var(--radius-sm);
            padding: 0.75rem;
            border: 1px solid var(--border);
        }

        .guideline-block h4 {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            padding-bottom: 0.25rem;
            border-bottom: 1px solid var(--border);
        }

        .guideline-block.dos h4 {
            color: #16a34a;
        }

        .guideline-block.donts h4 {
            color: #dc2626;
        }

        .guideline-block.instructions h4 {
            color: #2563eb;
        }

        .guideline-list {
            list-style: none;
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin: 0;
            padding: 0;
        }

        .guideline-list li {
            padding: 0.25rem 0;
            padding-left: 1.25rem;
            position: relative;
        }

        .guideline-block.dos .guideline-list li::before {
            content: '\2713';
            position: absolute;
            left: 0;
            color: #16a34a;
            font-weight: bold;
        }

        .guideline-block.donts .guideline-list li::before {
            content: '\2717';
            position: absolute;
            left: 0;
            color: #dc2626;
            font-weight: bold;
        }

        .guideline-block.instructions .guideline-list li::before {
            content: '\2022';
            position: absolute;
            left: 0;
            color: #2563eb;
        }

        .footer {
            text-align: center;
            margin-top: 2.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border);
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        @media (max-width: 640px) {
            .container { padding: 1.5rem 1rem; }
            .client-card { flex-direction: column; align-items: flex-start; padding: 1.25rem; }
            .client-meta { flex-wrap: wrap; }
            .day-header { flex-wrap: wrap; }
            .meals-timeline { padding-left: 1.5rem; }
            .meals-timeline::before { left: 5px; }
            .meal-block::before { left: -1.5rem; width: 12px; height: 12px; }
        }
    </style>
</head>
<body>
    <div class="container">

        <header class="header">
            <div class="brand">
                <div class="logo">
                    {{#if clinicLogo}}
                    <img src="{{clinicLogo}}" alt="Logo">
                    {{else}}
                    {{clinicInitials}}
                    {{/if}}
                </div>
                <div class="clinic-name">{{clinicName}}</div>
            </div>
            <div class="prepared-by">
                Prepared by: <strong>{{dietitianName}}</strong>
            </div>
        </header>

        <section class="client-card">
            <div class="client-name">{{clientName}}</div>
            <div class="client-meta">
                <span class="meta-tag">{{dateRange}}</span>
                {{#if targetCalories}}<span class="meta-tag">{{targetCalories}} kcal/day</span>{{/if}}
                {{#if targetProtein}}<span class="meta-tag">P:{{targetProtein}}g</span>{{/if}}
                {{#if targetCarbs}}<span class="meta-tag">C:{{targetCarbs}}g</span>{{/if}}
                {{#if targetFat}}<span class="meta-tag">F:{{targetFat}}g</span>{{/if}}
            </div>
        </section>

        {{#each days}}
        <section class="day-section{{#unless @first}} page-break{{/unless}}">
            <div class="day-header">
                <div class="day-number">
                    <span>Day</span>
                    <strong>{{dayNumber}}</strong>
                </div>
                <div class="day-info">
                    <h2>{{dateFormatted}}</h2>
                    {{#if totals.calories}}
                    <div class="day-nutrition">
                        <span class="nutrition-values">
                            <span class="cal">{{totals.calories}} cal</span>
                            <span class="protein">P:{{totals.protein}}</span>
                            <span class="carbs">C:{{totals.carbs}}</span>
                            <span class="fat">F:{{totals.fat}}</span>
                        </span>
                    </div>
                    {{/if}}
                </div>
            </div>
            <div class="meals-timeline">
                {{#each meals}}
                <div class="meal-block {{mealTypeClass}}">
                    <div class="meal-header">
                        <span class="meal-type">{{name}}</span>
                        {{#if time}}
                        <span class="meal-time">{{time}}</span>
                        {{/if}}
                    </div>
                    <div class="food-list">
                        {{#if totals.calories}}
                        <div class="meal-totals-bar">
                            <span class="nutrition-values">
                                <span class="cal">{{totals.calories}} cal</span>
                                <span class="protein">P:{{totals.protein}}</span>
                                <span class="carbs">C:{{totals.carbs}}</span>
                                <span class="fat">F:{{totals.fat}}</span>
                            </span>
                        </div>
                        {{/if}}
                        {{#if items.length}}
                        {{#each items}}
                        <div class="food-row">
                            <div class="food-row-main">
                                {{#if recipeUrl}}
                                <a href="{{recipeUrl}}" class="food-name food-link" target="_blank">{{foodName}}</a>
                                {{else}}
                                <span class="food-name">{{foodName}}</span>
                                {{/if}}
                                {{#if @root.includeQuantity}}<span class="food-qty">{{quantity}} {{unit}}</span>{{/if}}
                            </div>
                            {{#if nutrition.calories}}
                            <div class="item-nutrition">
                                <span class="nutrition-values">
                                    <span class="cal">{{nutrition.calories}} cal</span>
                                    <span class="protein">P:{{nutrition.protein}}</span>
                                    <span class="carbs">C:{{nutrition.carbs}}</span>
                                    <span class="fat">F:{{nutrition.fat}}</span>
                                </span>
                            </div>
                            {{/if}}
                            {{#if notes}}
                            <div class="food-notes">{{notes}}</div>
                            {{/if}}
                            {{#if alternatives.length}}
                            <div class="food-alternatives">
                                <span class="alternatives-label">Or:</span>
                                {{#each alternatives}}
                                <span class="alternative-item">
                                    {{#if recipeUrl}}
                                    <a href="{{recipeUrl}}" class="alt-link" target="_blank">{{foodName}}</a>
                                    {{else}}
                                    {{foodName}}
                                    {{/if}}
                                    {{#if @root.includeQuantity}}({{quantity}} {{unit}}){{/if}}{{#if notes}} - {{notes}}{{/if}}{{#unless @last}},{{/unless}}
                                </span>
                                {{/each}}
                            </div>
                            {{/if}}
                        </div>
                        {{/each}}
                        {{else}}
                        <div class="empty-meal">No items</div>
                        {{/if}}
                    </div>
                </div>
                {{/each}}
            </div>
        </section>
        {{/each}}

        {{#if guidelines.hasAny}}
        <section class="guidelines-section">
            <h3>Guidelines</h3>
            <div class="guidelines-columns">
                {{#if guidelines.dos.length}}
                <div class="guideline-block dos">
                    <h4>Do's</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.dos}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
                {{#if guidelines.donts.length}}
                <div class="guideline-block donts">
                    <h4>Don'ts</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.donts}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
                {{#if guidelines.instructions.length}}
                <div class="guideline-block instructions">
                    <h4>Instructions</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.instructions}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
            </div>
        </section>
        {{/if}}

        {{#if notes.length}}
        <section class="notes-card">
            <h3>Notes</h3>
            <ul>
                {{#each notes}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </section>
        {{/if}}

        {{#if contactInfo}}
        <footer class="footer">
            {{contactInfo}}
        </footer>
        {{/if}}

    </div>
</body>
</html>
