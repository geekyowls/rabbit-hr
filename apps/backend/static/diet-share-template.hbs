<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Diet Plan - {{clientName}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #2D5A4A;
            --primary-light: #3D7A64;
            --accent-color: #E8B86D;

            --bg-color: #FDFCF9;
            --surface-color: #FFFFFF;
            --surface-alt: #F7F5F0;

            --text-primary: #1A1A1A;
            --text-secondary: #5A5A5A;
            --text-muted: #8A8A8A;

            --breakfast-color: #F4A261;
            --lunch-color: #2A9D8F;
            --dinner-color: #6B5B95;
            --snack-color: #E76F51;

            --page-max-width: 900px;
            --border-radius: 10px;
        }

        @media print {
            body { display: none !important; }
            html::after {
                content: "Printing is disabled for this document.";
                display: block;
                padding: 50px;
                text-align: center;
                font-size: 18px;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        body {
            font-family: 'Source Sans 3', -apple-system, sans-serif;
            background: var(--bg-color);
            color: var(--text-primary);
            line-height: 1.5;
            font-size: 14px;
        }

        img {
            pointer-events: none;
            -webkit-user-drag: none;
        }

        .container {
            max-width: var(--page-max-width);
            margin: 0 auto;
            padding: 20px;
            position: relative;
        }

        .watermark {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 80px;
            color: rgba(0, 0, 0, 0.03);
            pointer-events: none;
            white-space: nowrap;
            z-index: 1000;
            font-weight: bold;
            font-family: 'Playfair Display', serif;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid var(--surface-alt);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .logo {
            width: 48px;
            height: 48px;
            background: var(--primary-color);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 10px;
        }

        .clinic-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--primary-color);
        }

        .header-meta {
            text-align: right;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .client-info {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
            color: white;
            border-radius: var(--border-radius);
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .client-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.35rem;
            font-weight: 500;
        }

        .client-details {
            display: flex;
            gap: 1.5rem;
            font-size: 0.9rem;
            opacity: 0.95;
        }

        .client-details span {
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .days-container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .day-card {
            background: var(--surface-color);
            border-radius: var(--border-radius);
            overflow: hidden;
            border: 1px solid var(--surface-alt);
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .day-header {
            background: var(--primary-color);
            color: white;
            padding: 1rem 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .day-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: white;
        }

        .day-date {
            font-size: 1rem;
            color: rgba(255,255,255,0.9);
            font-weight: 500;
        }

        .meals-list {
            padding: 1rem;
        }

        .meal-item {
            display: grid;
            grid-template-columns: 100px 1fr;
            gap: 1rem;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 0.75rem;
            background: var(--bg-color);
            align-items: start;
        }

        .meal-item:last-child { margin-bottom: 0; }

        .meal-type {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }

        .meal-type-badge {
            padding: 0.35rem 0.7rem;
            border-radius: 5px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            text-align: center;
            color: white;
        }

        .meal-type-badge.breakfast { background: var(--breakfast-color); }
        .meal-type-badge.lunch { background: var(--lunch-color); }
        .meal-type-badge.dinner { background: var(--dinner-color); }
        .meal-type-badge.snack { background: var(--snack-color); }
        .meal-type-badge.other { background: var(--text-muted); }

        .meal-time {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-align: center;
        }

        .food-items {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .food-item {
            display: flex;
            flex-direction: column;
            padding: 0.5rem 0;
            border-bottom: 1px dashed rgba(0,0,0,0.06);
            gap: 0.2rem;
        }

        .food-item:last-child { border-bottom: none; }

        .food-item-main {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .food-notes {
            font-style: italic;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .food-name {
            font-size: 1rem;
            color: var(--text-primary);
        }

        .food-link {
            color: var(--primary-color);
            text-decoration: none;
            border-bottom: 1px dashed var(--primary-color);
        }

        .food-link:hover {
            color: var(--primary-light);
        }

        .food-qty {
            font-size: 0.9rem;
            color: var(--text-muted);
            white-space: nowrap;
            margin-left: auto;
        }

        .guidelines-section {
            margin-top: 1.5rem;
        }

        .guidelines-section h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            color: var(--primary-color);
            margin-bottom: 0.75rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--primary-color);
        }

        .guidelines-columns {
            display: flex;
            gap: 1rem;
        }

        @media (max-width: 600px) {
            .guidelines-columns {
                flex-direction: column;
            }
        }

        .guideline-block {
            flex: 1;
            background: var(--surface-color);
            border-radius: var(--border-radius);
            padding: 1rem;
            border: 1px solid var(--surface-alt);
        }

        .guideline-block h4 {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            padding-bottom: 0.4rem;
            border-bottom: 1px solid var(--surface-alt);
        }

        .guideline-block.dos h4 {
            color: #16a34a;
        }

        .guideline-block.donts h4 {
            color: #dc2626;
        }

        .guideline-block.instructions h4 {
            color: #2563eb;
        }

        .guideline-list {
            list-style: none;
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin: 0;
            padding: 0;
        }

        .guideline-list li {
            padding: 0.25rem 0;
            padding-left: 1.25rem;
            position: relative;
        }

        .guideline-block.dos .guideline-list li::before {
            content: '\2713';
            position: absolute;
            left: 0;
            color: #16a34a;
            font-weight: bold;
        }

        .guideline-block.donts .guideline-list li::before {
            content: '\2717';
            position: absolute;
            left: 0;
            color: #dc2626;
            font-weight: bold;
        }

        .guideline-block.instructions .guideline-list li::before {
            content: '\2022';
            position: absolute;
            left: 0;
            color: #2563eb;
        }

        .notes-section {
            background: var(--surface-color);
            border-radius: var(--border-radius);
            padding: 1.25rem;
            margin-top: 1.5rem;
            border: 1px solid var(--surface-alt);
            border-left: 4px solid var(--accent-color);
        }

        .notes-section h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            color: var(--primary-color);
            margin-bottom: 0.75rem;
        }

        .notes-list {
            list-style: none;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .notes-list li {
            padding: 0.4rem 0;
            padding-left: 1.5rem;
            position: relative;
        }

        .notes-list li::before {
            content: '\2022';
            position: absolute;
            left: 0;
            color: var(--primary-color);
        }

        .footer {
            text-align: center;
            margin-top: 2rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--surface-alt);
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .empty-meal {
            color: var(--text-muted);
            font-style: italic;
            font-size: 0.9rem;
        }

        .food-alternatives {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 2px;
            padding-left: 8px;
        }

        .alternatives-label {
            font-style: italic;
            margin-right: 4px;
        }

        .alternative-item {
            margin-right: 4px;
        }

        .alt-link {
            color: var(--primary-color);
            text-decoration: none;
        }

        .alt-link:hover {
            text-decoration: underline;
        }

        .nutrition-values {
            display: inline-flex;
            gap: 0.4rem;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .nutrition-values .cal { color: #ea580c; }
        .nutrition-values .protein { color: #2563eb; }
        .nutrition-values .carbs { color: #16a34a; }
        .nutrition-values .fat { color: #d97706; }
        .meal-totals-bar {
            background: #fff7ed;
            padding: 0.4rem 0.75rem;
            border-radius: 6px;
            margin-bottom: 0.5rem;
        }
        .item-nutrition {
            font-size: 0.65rem;
            margin-top: 0.15rem;
            opacity: 0.85;
        }
        .day-nutrition {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.9);
        }

        @media (max-width: 600px) {
            .container { padding: 12px; }
            .header {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }
            .header-meta {
                text-align: left;
            }
            .day-header {
                flex-wrap: wrap;
                gap: 0.25rem 0.75rem;
            }
            .day-title {
                font-size: 1.2rem;
            }
            .day-date {
                font-size: 0.85rem;
            }
            .day-nutrition {
                width: 100%;
                margin-top: 0.25rem;
            }
            .meal-item {
                grid-template-columns: 1fr;
                gap: 0.6rem;
            }
            .meal-type {
                flex-direction: row;
                align-items: center;
                gap: 0.6rem;
            }
            .client-info {
                flex-direction: column;
                align-items: flex-start;
            }
            .client-details {
                flex-wrap: wrap;
                gap: 1rem;
            }
            .watermark {
                font-size: 40px;
            }
        }
        .meal-photo-section {
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px dashed #e2e8f0;
        }
        .meal-photo-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 8px;
        }
        .meal-photo-thumb {
            position: relative;
            width: 64px;
            height: 64px;
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
        }
        .meal-photo-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .meal-photo-thumb .remove-btn {
            position: absolute;
            top: 2px;
            right: 2px;
            background: rgba(0,0,0,0.6);
            color: #fff;
            border: none;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 12px;
            line-height: 18px;
            cursor: pointer;
            padding: 0;
        }
        .meal-photo-add {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #1d3d28;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s;
        }
        .meal-photo-add:hover { background: #163325; }
        .meal-photo-add:disabled { opacity: 0.6; cursor: not-allowed; }
        .meal-photo-add input[type="file"] {
            opacity: 0;
            position: absolute;
            width: 1px;
            height: 1px;
            pointer-events: none;
        }
        .meal-photo-error {
            color: #b91c1c;
            background: #fee2e2;
            border: 1px solid #fecaca;
            border-radius: 6px;
            font-size: 13px;
            padding: 8px 12px;
            margin-top: 8px;
        }
    </style>
</head>
<body>
    <div class="watermark">{{clinicName}}</div>

    <div class="container">
        <header class="header">
            <div class="brand">
                <div class="logo">
                    {{#if clinicLogo}}
                    <img src="{{clinicLogo}}" alt="Logo">
                    {{else}}
                    {{clinicInitials}}
                    {{/if}}
                </div>
                <div class="clinic-name">{{clinicName}}</div>
            </div>
            <div class="header-meta">
                <div>Personalized Diet Plan</div>
            </div>
        </header>

        <section class="client-info">
            <div class="client-name">{{clientName}}</div>
            <div class="client-details">
                <span>📅 {{dateRange}}</span>
                {{#if targetCalories}}<span>🎯 {{targetCalories}} kcal/day</span>{{/if}}
                {{#if targetProtein}}<span>P:{{targetProtein}}g</span>{{/if}}
                {{#if targetCarbs}}<span>C:{{targetCarbs}}g</span>{{/if}}
                {{#if targetFat}}<span>F:{{targetFat}}g</span>{{/if}}
            </div>
        </section>

        <nav class="day-nav" aria-label="Jump to day">
            <div class="day-nav-scroll" id="dayNavScroll">
                {{#each days}}
                <a class="day-chip" data-date="{{date}}" data-day-id="day-{{dayNumber}}" href="#day-{{dayNumber}}">
                    <span class="chip-label">Day {{dayNumber}}</span>
                    <span class="chip-date">{{dateFormatted}}</span>
                </a>
                {{/each}}
            </div>
        </nav>

        <div class="days-container">
            {{#each days}}
            <article class="day-card" id="day-{{dayNumber}}" data-date="{{date}}">
                <div class="day-header">
                    <div class="day-title">Day {{dayNumber}}</div>
                    <div class="day-date">{{dateFormatted}}</div>
                    {{#if totals.calories}}
                    <div class="day-nutrition">
                        <span class="nutrition-values">
                            <span class="cal">{{totals.calories}} cal</span>
                            <span class="protein">P:{{totals.protein}}</span>
                            <span class="carbs">C:{{totals.carbs}}</span>
                            <span class="fat">F:{{totals.fat}}</span>
                        </span>
                    </div>
                    {{/if}}
                </div>
                <div class="meals-list">
                    {{#each meals}}
                    <div class="meal-item">
                        <div class="meal-type">
                            <div class="meal-type-badge {{mealTypeClass}}">{{name}}</div>
                            {{#if time}}
                            <div class="meal-time">{{time}}</div>
                            {{/if}}
                        </div>
                        <div class="food-items">
                            {{#if totals.calories}}
                            <div class="meal-totals-bar">
                                <span class="nutrition-values">
                                    <span class="cal">{{totals.calories}} cal</span>
                                    <span class="protein">P:{{totals.protein}}</span>
                                    <span class="carbs">C:{{totals.carbs}}</span>
                                    <span class="fat">F:{{totals.fat}}</span>
                                </span>
                            </div>
                            {{/if}}
                            {{#if items.length}}
                            {{#each items}}
                            <div class="food-item">
                                <div class="food-item-main">
                                    {{#if recipeUrl}}
                                    <a href="{{recipeUrl}}" class="food-name food-link" target="_blank" rel="noopener">{{foodName}}</a>
                                    {{else}}
                                    <span class="food-name">{{foodName}}</span>
                                    {{/if}}
                                    {{#if @root.includeQuantity}}<span class="food-qty">{{quantity}} {{unit}}</span>{{/if}}
                                </div>
                                {{#if nutrition.calories}}
                                <div class="item-nutrition">
                                    <span class="nutrition-values">
                                        <span class="cal">{{nutrition.calories}} cal</span>
                                        <span class="protein">P:{{nutrition.protein}}</span>
                                        <span class="carbs">C:{{nutrition.carbs}}</span>
                                        <span class="fat">F:{{nutrition.fat}}</span>
                                    </span>
                                </div>
                                {{/if}}
                                {{#if notes}}
                                <div class="food-notes">{{notes}}</div>
                                {{/if}}
                                {{#if alternatives.length}}
                                <div class="food-alternatives">
                                    <span class="alternatives-label">Or:</span>
                                    {{#each alternatives}}
                                    <span class="alternative-item">
                                        {{#if recipeUrl}}
                                        <a href="{{recipeUrl}}" class="alt-link" target="_blank" rel="noopener">{{foodName}}</a>
                                        {{else}}
                                        {{foodName}}
                                        {{/if}}
                                        {{#if @root.includeQuantity}}({{quantity}} {{unit}}){{/if}}{{#if notes}} - {{notes}}{{/if}}{{#unless @last}},{{/unless}}
                                    </span>
                                    {{/each}}
                                </div>
                                {{/if}}
                            </div>
                            {{/each}}
                            {{else}}
                            <div class="empty-meal">No items</div>
                            {{/if}}
                            {{#if @root.uploadEnabled}}
                            <div class="meal-photo-section" data-meal-photo-section data-date="{{date}}" data-meal-index="{{mealIndex}}">
                                <div class="meal-photo-strip" data-meal-photo-strip>
                                    {{#each photos}}
                                    <div class="meal-photo-thumb" data-photo-id="{{id}}">
                                        <img src="{{url}}" alt="meal photo" loading="lazy" />
                                        <button type="button" class="remove-btn" data-meal-photo-remove aria-label="Remove photo">&times;</button>
                                    </div>
                                    {{/each}}
                                </div>
                                <label class="meal-photo-add">
                                    <span data-meal-photo-label>Add meal photo</span>
                                    <input type="file" accept="image/*" capture="environment" data-meal-photo-input />
                                </label>
                                <div class="meal-photo-error" data-meal-photo-error hidden></div>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </article>
            {{/each}}
        </div>

        {{#if guidelines.hasAny}}
        <section class="guidelines-section">
            <h3>Guidelines</h3>
            <div class="guidelines-columns">
                {{#if guidelines.dos.length}}
                <div class="guideline-block dos">
                    <h4>Do's</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.dos}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
                {{#if guidelines.donts.length}}
                <div class="guideline-block donts">
                    <h4>Don'ts</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.donts}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
                {{#if guidelines.instructions.length}}
                <div class="guideline-block instructions">
                    <h4>Instructions</h4>
                    <ul class="guideline-list">
                        {{#each guidelines.instructions}}
                        <li>{{this}}</li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}
            </div>
        </section>
        {{/if}}

        {{#if notes.length}}
        <section class="notes-section">
            <h3>Notes</h3>
            <ul class="notes-list">
                {{#each notes}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </section>
        {{/if}}

        {{#if contactInfo}}
        <footer class="footer">
            <p>Generated by {{clinicName}} • {{contactInfo}}</p>
        </footer>
        {{/if}}
    </div>

    <script>
        (function() {
            document.addEventListener('contextmenu', function(e) {
                e.preventDefault();
                return false;
            });

            document.addEventListener('keydown', function(e) {
                if (e.ctrlKey || e.metaKey) {
                    if (e.key === 'p' || e.key === 'P' ||
                        e.key === 's' || e.key === 'S' ||
                        e.key === 'c' || e.key === 'C' ||
                        e.key === 'a' || e.key === 'A') {
                        e.preventDefault();
                        return false;
                    }
                }
                if (e.key === 'PrintScreen') {
                    e.preventDefault();
                    return false;
                }
            });

            document.addEventListener('copy', function(e) {
                e.preventDefault();
                return false;
            });

            document.addEventListener('cut', function(e) {
                e.preventDefault();
                return false;
            });

            if (window.matchMedia) {
                var mediaQueryList = window.matchMedia('print');
                mediaQueryList.addListener(function(mql) {
                    if (mql.matches) {
                        document.body.style.display = 'none';
                    }
                });
            }
        })();
    </script>
<style>
.day-nav { background: #fff; border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; position: sticky; top: 8px; z-index: 10; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
.day-nav-scroll { display: flex; gap: 6px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
.day-nav-scroll::-webkit-scrollbar { height: 4px; }
.day-nav-scroll::-webkit-scrollbar-thumb { background: #cdd9cc; border-radius: 2px; }
.day-chip { flex-shrink: 0; background: #f1f5ed; border: 1.5px solid transparent; color: #1a2a1e; border-radius: 8px; padding: 8px 12px; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.15s; min-width: 90px; text-align: center; }
.day-chip:hover { background: #e3ead9; }
.day-chip.active { background: #1d3d28; color: #fff; border-color: #1d3d28; }
.day-chip.is-today { border-color: #1d3d28; }
.day-chip .chip-label { display: block; font-size: 12px; }
.day-chip .chip-date { display: block; font-size: 11px; opacity: 0.8; font-weight: 500; margin-top: 1px; }
.day-chip.is-today .chip-label::before { content: '\2605 '; }
.day-card { scroll-margin-top: 90px; }
</style>
<script>
(function(){
  var todayLocal = (function(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); })();
  var chips = document.querySelectorAll('.day-chip');
  var sections = document.querySelectorAll('.day-card');
  var scroller = document.getElementById('dayNavScroll');
  function setActive(id){ chips.forEach(function(c){ c.classList.toggle('active', c.dataset.dayId === id); }); }
  var todayChip = null;
  chips.forEach(function(c){ if (c.dataset.date === todayLocal) { c.classList.add('is-today'); todayChip = c; } });
  if (todayChip && scroller) {
    var t = document.getElementById(todayChip.dataset.dayId);
    if (t) setTimeout(function(){ t.scrollIntoView({ behavior:'auto', block:'start' }); window.scrollBy(0, -8); }, 50);
    var r = todayChip.getBoundingClientRect();
    var sr = scroller.getBoundingClientRect();
    scroller.scrollLeft = todayChip.offsetLeft - (sr.width - r.width)/2;
    setActive(todayChip.dataset.dayId);
  } else if (chips.length) {
    setActive(chips[0].dataset.dayId);
  }
  if ('IntersectionObserver' in window && sections.length) {
    var obs = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if (e.isIntersecting) setActive(e.target.id); }); }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });
    sections.forEach(function(s){ obs.observe(s); });
  }
})();
</script>
{{#if uploadEnabled}}
<script>
(function(){
  var SHARE_TOKEN = '{{shareToken}}';
  var API_BASE = '/d/' + SHARE_TOKEN;
  var MAX_DIM = 1600;
  var JPEG_QUALITY = 0.8;

  function showError(section, msg){
    var el = section.querySelector('[data-meal-photo-error]');
    if (!el) return;
    el.textContent = msg || '';
    el.hidden = !msg;
  }

  function setBusy(section, busy){
    var label = section.querySelector('[data-meal-photo-label]');
    var input = section.querySelector('[data-meal-photo-input]');
    if (label) label.textContent = busy ? 'Uploading...' : 'Add meal photo';
    if (input) input.disabled = !!busy;
  }

  function extensionForMime(mime){
    if (!mime) return 'jpg';
    if (mime === 'image/jpeg' || mime === 'image/jpg') return 'jpg';
    if (mime === 'image/png') return 'png';
    if (mime === 'image/webp') return 'webp';
    if (mime === 'image/gif') return 'gif';
    if (mime === 'image/heic') return 'heic';
    if (mime === 'image/heif') return 'heif';
    return 'jpg';
  }

  function isHeicLike(file){
    var t = (file.type || '').toLowerCase();
    if (t === 'image/heic' || t === 'image/heif') return true;
    var n = (file.name || '').toLowerCase();
    return /\.(heic|heif)$/.test(n);
  }

  function rawBlob(file){
    var type = file.type || 'image/jpeg';
    return { blob: file, contentType: type, extension: extensionForMime(type) };
  }

  function compress(file){
    if (isHeicLike(file)) {
      return Promise.resolve(rawBlob(file));
    }
    return new Promise(function(resolve){
      var img = new Image();
      var url = URL.createObjectURL(file);
      img.onload = function(){
        URL.revokeObjectURL(url);
        var w = img.width, h = img.height;
        if (w > MAX_DIM || h > MAX_DIM) {
          if (w >= h) { h = Math.round(h * (MAX_DIM / w)); w = MAX_DIM; }
          else { w = Math.round(w * (MAX_DIM / h)); h = MAX_DIM; }
        }
        var canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        var ctx = canvas.getContext('2d');
        if (!ctx) { resolve(rawBlob(file)); return; }
        ctx.drawImage(img, 0, 0, w, h);
        canvas.toBlob(function(blob){
          if (!blob) { resolve(rawBlob(file)); return; }
          resolve({ blob: blob, contentType: 'image/jpeg', extension: 'jpg' });
        }, 'image/jpeg', JPEG_QUALITY);
      };
      img.onerror = function(){
        URL.revokeObjectURL(url);
        resolve(rawBlob(file));
      };
      img.src = url;
    });
  }

  function appendThumb(strip, photo){
    var div = document.createElement('div');
    div.className = 'meal-photo-thumb';
    div.setAttribute('data-photo-id', photo.id);
    var img = document.createElement('img');
    img.src = photo.url; img.alt = 'meal photo'; img.loading = 'lazy';
    var btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'remove-btn';
    btn.setAttribute('data-meal-photo-remove', '');
    btn.setAttribute('aria-label', 'Remove photo');
    btn.innerHTML = '&times;';
    div.appendChild(img); div.appendChild(btn);
    strip.appendChild(div);
  }

  function getJson(res){
    return res.text().then(function(t){
      var parsed = null;
      try { parsed = t ? JSON.parse(t) : null; } catch (e) { parsed = null; }
      if (!res.ok) {
        var msg = (parsed && (parsed.message || parsed.error)) || ('Request failed (' + res.status + ')');
        throw new Error(Array.isArray(msg) ? msg.join(', ') : msg);
      }
      return parsed && parsed.data !== undefined ? parsed.data : parsed;
    });
  }

  function uploadFor(section, file){
    var date = section.dataset.date;
    var mealIndex = parseInt(section.dataset.mealIndex, 10);
    var strip = section.querySelector('[data-meal-photo-strip]');
    showError(section, '');

    if (!date || Number.isNaN(mealIndex)) {
      showError(section, 'This meal cannot accept photos right now. Please refresh the page.');
      return Promise.resolve();
    }

    setBusy(section, true);

    return compress(file).then(function(prepared){
      var contentType = prepared.contentType;
      var extension = prepared.extension;
      return fetch(
        API_BASE + '/upload-url?date=' + encodeURIComponent(date) + '&mealIndex=' + mealIndex + '&extension=' + encodeURIComponent(extension),
        { method: 'GET', credentials: 'same-origin', headers: { 'X-Diet-Share-Token': SHARE_TOKEN } }
      ).then(getJson).then(function(presign){
        return fetch(presign.signedUrl, {
          method: 'PUT', body: prepared.blob, headers: { 'Content-Type': contentType }
        }).then(function(putRes){
          if (!putRes.ok) throw new Error('Upload failed (' + putRes.status + ')');
          return fetch(API_BASE + '/meal-photo', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-Diet-Share-Token': SHARE_TOKEN },
            body: JSON.stringify({ date: date, mealIndex: mealIndex, photoKey: presign.key })
          }).then(getJson);
        });
      });
    }).then(function(photo){
      appendThumb(strip, photo);
    }).catch(function(err){
      if (typeof console !== 'undefined' && console.error) console.error('[meal-photo]', err);
      showError(section, err && err.message ? err.message : 'Upload failed');
    }).then(function(){
      setBusy(section, false);
    });
  }

  function removePhoto(section, thumb){
    var date = section.dataset.date;
    var mealIndex = parseInt(section.dataset.mealIndex, 10);
    var photoId = thumb.getAttribute('data-photo-id');
    showError(section, '');
    return fetch(API_BASE + '/meal-photo', {
      method: 'DELETE',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-Diet-Share-Token': SHARE_TOKEN },
      body: JSON.stringify({ date: date, mealIndex: mealIndex, photoId: photoId })
    }).then(getJson).then(function(){
      thumb.parentNode && thumb.parentNode.removeChild(thumb);
    }).catch(function(err){
      if (typeof console !== 'undefined' && console.error) console.error('[meal-photo:delete]', err);
      showError(section, err && err.message ? err.message : 'Delete failed');
    });
  }

  document.querySelectorAll('[data-meal-photo-section]').forEach(function(section){
    var input = section.querySelector('[data-meal-photo-input]');
    if (input) {
      input.addEventListener('change', function(e){
        var file = e.target.files && e.target.files[0];
        if (file) uploadFor(section, file);
        e.target.value = '';
      });
    }
    section.addEventListener('click', function(e){
      var target = e.target;
      if (target && target.matches('[data-meal-photo-remove]')) {
        var thumb = target.closest('.meal-photo-thumb');
        if (thumb) removePhoto(section, thumb);
      }
    });
  });
})();
</script>
{{/if}}
</body>
</html>
