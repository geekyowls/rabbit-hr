{
  "name": "@boilerplate/shared",
  "version": "0.2.10",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./form-validation/zod": {
      "types": "./dist/form-validation/zod-adapter.d.ts",
      "default": "./dist/form-validation/zod-adapter.js"
    },
    "./client-app-config": {
      "types": "./dist/client-app-config/index.d.ts",
      "default": "./dist/client-app-config/index.js"
    },
    "./phone": {
      "types": "./dist/phone/index.d.ts",
      "default": "./dist/phone/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "libphonenumber-js": "^1.12.40",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
